# Upstox API app credentials (create an app at https://account.upstox.com/developer/apps)
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here

# Must exactly match the redirect URI configured in your Upstox app
UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Server
HOST=0.0.0.0
PORT=8000
